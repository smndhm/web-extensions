    "changeset:publish": "changeset publish",
    "changeset:renovate": "changesets-renovate"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@scaleway/changesets-renovate": "4.0.5",
    "selenium-webdriver": "^4.51.0"
  }
