{
  "name": "web-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "build:firefox": "pnpm -r build:firefox",
    "zip": "pnpm -r zip",
    "zip:firefox": "pnpm -r zip:firefox",
    "compile": "pnpm -r compile",
    "test": "pnpm -r --if-present test",
