{
  "name": "dzr-link",
  "version": "1.5.1",
  "description": "Open Deezer links in the desktop app instead of the browser.",
  "private": true,
  "license": "BSD-2-Clause",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "a11y": "node scripts/a11y.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@dume/dev-config": "1.4.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
