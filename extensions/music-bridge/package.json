{
  "name": "music-bridge",
  "version": "1.12.3",
  "description": "Open any music link on your favorite streaming platform, in one click.",
  "private": true,
  "license": "BSD-2-Clause",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.ts",
    "a11y": "node scripts/a11y.ts",
    "test-links": "node scripts/test-links.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@dume/dev-config": "1.4.0",
    "@dume/ds": "0.8.0",
    "@types/node": "26.6.6",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "rampensau": "2.4.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
