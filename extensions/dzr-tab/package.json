{
  "name": "dzr-tab",
  "version": "2.2.4",
  "description": "Discover a Deezer track every time you open a new tab.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "a11y": "node scripts/a11y.ts",
    "screenshots": "node scripts/screenshots.ts",
    "postinstall": "wxt prepare"
  },
  "keywords": [
    "dzr",
    "deezer",
    "tab",
    "browser"
  ],
  "author": "@smndhm",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@dume/dev-config": "1.4.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "node-vibrant": "^4.0.4"
  }
}
