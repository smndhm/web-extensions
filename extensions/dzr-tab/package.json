{
  "name": "dzr-tab",
  "version": "2.1.0",
  "description": "Discover a Deezer Track every time you open a new tab.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "keywords": [
    "dzr",
    "deezer",
    "tab",
    "browser"
  ],
  "author": "@smndhm",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "node-vibrant": "^4.0.4"
  }
}
